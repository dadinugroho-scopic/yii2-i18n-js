{
  "name": "w3lifer/yii2-i18n-js",
  "description": "Yii2 internationalization in JavaScript",
  "keywords": [
    "yii2",
    "i18n",
    "js"
  ],
  "type": "yii2-extension",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/dadinugroho-scopic/php-helper"
    }
  ],
  "require": {
    "php": "^7.2",
    "yiisoft/yii2": "^2.0",
    "w3lifer/php-helper": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "w3lifer\\Yii2\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Roman Grinyov",
      "email": "w3lifer@gmail.com"
    }
  ],
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true
}
